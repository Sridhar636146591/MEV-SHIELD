{
  "manifest_version": 3,
  "name": "MEV Detector - Real-Time Protection",
  "version": "1.0.0",
  "description": "Protect yourself from MEV attacks, sandwich attacks, and front-running while browsing dApps",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "MEV Detector"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "https://api.mevdetector.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js", "styles.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
